---
// Uma placa da peça principal que é uma janela de navegador (SVG 1200 × 720): o protótipo (etapa 2), o código (etapa 3)
// e o site no ar (etapa 5). O mesmo desenho serve às três; o que muda é o que cada uma mostra (variante). Todo texto vem
// de pt.ts. Uma ilustração, não um site de verdade.
import type { Textos } from '../i18n/pt';

interface Props {
  t: Textos;
  variante: 'prototipo' | 'codigo' | 'noar';
}
const { t, variante } = Astro.props;
const p = t.peca;
const solido = variante !== 'prototipo';
---

<svg
  class="placa__svg"
  viewBox="0 0 1200 720"
  data-fase={solido ? 'solido' : 'esboco'}
  aria-hidden="true"
  focusable="false"
>
  <rect class="moldura" x="40" y="20" width="1120" height="680" rx="4"></rect>
  <line class="traco" x1="40" y1="76" x2="1160" y2="76"></line>
  <rect class="traco" x="120" y="34" width="760" height="28" rx="4"></rect>
  <text class="mono-svg" x="136" y="53" data-endereco>
    {p.endereco}
  </text>

  <!-- a página de exemplo: no esboço, blocos tracejados; no código e no ar, preenchida e com texto -->
  <g data-g="telaA">
    <rect class="bloco" x="80" y="108" width="1040" height="250" rx="4"></rect>
    <g class="esb">
      <rect class="barra-esb" x="120" y="150" width="420" height="22" rx="2"></rect>
      <rect class="barra-esb" x="120" y="186" width="340" height="22" rx="2"></rect>
      <rect class="barra-esb" x="120" y="236" width="460" height="10" rx="2"></rect>
      <rect class="barra-esb" x="120" y="256" width="420" height="10" rx="2"></rect>
    </g>
    <g class="txt">
      <text class="svg-titulo" x="120" y="176">
        {p.mock.titulo[0]}
      </text>
      <text class="svg-titulo" x="120" y="218">
        {p.mock.titulo[1]}
      </text>
      <rect class="barra-txt" x="120" y="246" width="420" height="10" rx="2"></rect>
      <rect class="barra-txt" x="120" y="266" width="360" height="10" rx="2"></rect>
    </g>
    <rect class="bloco botao-mock" x="120" y="296" width="190" height="44" rx="4"></rect>
    <text class="svg-botao txt" x="140" y="324">
      {p.mock.botao}
    </text>
    <rect class="bloco" x="640" y="130" width="440" height="200" rx="4"></rect>
    <line class="traco fino" x1="640" y1="130" x2="1080" y2="330"></line>
    <line class="traco fino" x1="1080" y1="130" x2="640" y2="330"></line>
    {[80, 435, 790].map((x) => (
      <g>
        <rect class="bloco" x={x} y="400" width="330" height="190" rx="4" />
        <rect class="bloco" x={x + 24} y="424" width="40" height="40" rx="4" />
        <rect class="barra-esb" x={x + 24} y="490" width="220" height="12" rx="2" />
        <rect class="barra-esb" x={x + 24} y="514" width="270" height="10" rx="2" />
        <rect class="barra-esb" x={x + 24} y="534" width="200" height="10" rx="2" />
      </g>
    ))}
    <rect class="bloco" x="80" y="620" width="1040" height="56" rx="4"></rect>
  </g>

  {variante === 'prototipo' && (
    <>
      <g data-g="telaB">
        {[108, 385].flatMap((y) =>
          [80, 435, 790].map((x) => (
            <g>
              <rect class="bloco" x={x} y={y} width="330" height="250" rx="4" />
              <rect class="bloco" x={x + 20} y={y + 20} width="290" height="120" rx="4" />
              <rect class="barra-esb" x={x + 20} y={y + 166} width="200" height="12" rx="2" />
              <rect class="barra-esb" x={x + 20} y={y + 190} width="250" height="10" rx="2" />
            </g>
          )),
        )}
      </g>
      <g data-g="telaC">
        <rect class="barra-esb" x="120" y="140" width="400" height="26" rx="2"></rect>
        <rect class="barra-esb" x="120" y="184" width="320" height="26" rx="2"></rect>
        <rect class="barra-esb" x="120" y="240" width="420" height="10" rx="2"></rect>
        <rect class="barra-esb" x="120" y="260" width="380" height="10" rx="2"></rect>
        <rect class="bloco" x="660" y="130" width="440" height="52" rx="4"></rect>
        <rect class="bloco" x="660" y="206" width="440" height="52" rx="4"></rect>
        <rect class="bloco" x="660" y="282" width="440" height="150" rx="4"></rect>
        <rect class="bloco" x="660" y="460" width="190" height="52" rx="4"></rect>
      </g>
    </>
  )}

  <!-- as três abas do protótipo -->
  <g data-g="tabs" class={variante === 'prototipo' ? '' : 'apagado'}>
    {[0, 1, 2].map((i) => (
      <g data-aba={i}>
        <rect class="aba" x={1010 + i * 44} y="34" width="36" height="28" rx="4" />
        <text class="mono-svg centro" x={1028 + i * 44} y="53">
          {i + 1}
        </text>
      </g>
    ))}
  </g>

  {variante === 'codigo' && (
    <g data-g="codigo">
      <rect class="painel" x="700" y="76" width="460" height="624" rx="0"></rect>
      {p.codigo.map((_, i) => (
        <text class="mono-svg codigo-linha" x="728" y={126 + i * 36} data-linha={i} />
      ))}
    </g>
  )}

  {variante === 'noar' && (
    <g data-g="status">
      <g data-pulso>
        <rect class="barrinha-svg" width="18" height="12" rx="2" transform="translate(912 41) skewX(-36)"></rect>
      </g>
      <text class="mono-svg" x="944" y="53">
        {p.noAr}
      </text>
    </g>
  )}

  {variante === 'prototipo' && (
    <g data-g="cursor">
      <rect class="barrinha-svg" width="18" height="12" rx="2" transform="skewX(-36)"></rect>
    </g>
  )}
</svg>

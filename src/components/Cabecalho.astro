---
// Cabeçalho fixo (movimento/nav.ts cuida do scroll e do menu do celular). A folha de links fica FORA do <header>:
// o backdrop-filter da barra viraria o "bloco de contenção" e prenderia a folha dentro dela.
import type { Textos } from '../i18n/pt';
import Logo from './Logo.astro';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const c = t.cabecalho;
---

<a class="pular" href="#topo">
  {t.pular}
</a>
<header class="nav" data-nav>
  <a class="nav__marca" href="/" aria-label={c.marca}>
    <Logo class="nav__logo" />
  </a>
  <nav class="nav__links" aria-label={c.aria}>
    {c.links.map((l) => (
      <a href={l.href}>
        <span aria-hidden="true">[ </span>
        {l.rotulo}
        <span aria-hidden="true"> ]</span>
      </a>
    ))}
  </nav>
  <a class="btn btn--principal nav__cta" href={c.ctaHref}>
    {c.cta}
  </a>
  <button class="nav__menu" type="button" data-menu-botao aria-expanded="false" aria-controls="menu-folha">
    <span class="nav__menu-abrir">{c.menu}</span>
    <span class="nav__menu-fechar">{c.fechar}</span>
  </button>
</header>
<div class="folha" id="menu-folha" data-menu-folha>
  <nav aria-label={c.aria}>
    {c.links.map((l) => (
      <a href={l.href}>{l.rotulo}</a>
    ))}
  </nav>
  <a class="btn btn--principal nav__cta" href={c.ctaHref}>
    {c.cta}
  </a>
</div>

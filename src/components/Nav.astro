---
// Nav fixa (movimento/nav.ts cuida do scroll e do menu do celular). A folha de links fica FORA do <header>:
// o backdrop-filter da barra viraria o "bloco de contenção" e prenderia a folha dentro dela.
import type { Textos } from '../i18n/pt';
import { PARTES, SIMBOLO_W, SIMBOLO_H } from '../lib/mundo/simbolo';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const n = t.nav;
---

<a class="pular" href="#topo">
  {n.pular}
</a>
<header class="nav" data-nav>
  <a class="nav__marca" href="#inicio" aria-label={n.marca}>
    <svg viewBox={`0 0 ${SIMBOLO_W} ${SIMBOLO_H}`} aria-hidden="true">
      {PARTES.c.map(([d, x, y]) => (
        <path d={d} transform={`translate(${x} ${y})`} fill="currentColor" />
      ))}
      {PARTES.elos.map(([d, x, y]) => (
        <path d={d} transform={`translate(${x} ${y})`} fill="#E8132E" />
      ))}
    </svg>
    <span>{n.marca}</span>
  </a>
  <nav class="nav__links" aria-label={n.aria}>
    {n.links.map((l) => (
      <a href={l.href}>
        <span aria-hidden="true">[ </span>
        {l.rotulo}
        <span aria-hidden="true"> ]</span>
      </a>
    ))}
  </nav>
  <a class="btn nav__cta" href={n.ctaHref}>
    {n.cta}
  </a>
  <button class="nav__menu" type="button" data-menu-botao aria-expanded="false" aria-controls="menu-folha">
    <span class="nav__menu-abrir">{n.menu}</span>
    <span class="nav__menu-fechar">{n.fechar}</span>
  </button>
</header>
<div class="folha" id="menu-folha" data-menu-folha>
  <nav aria-label={n.aria}>
    {n.links.map((l) => (
      <a href={l.href}>{l.rotulo}</a>
    ))}
  </nav>
  <a class="btn nav__cta" href={n.ctaHref}>
    {n.cta}
  </a>
</div>

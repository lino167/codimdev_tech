---
// Cena 01, o hero: o título (que o cursor `código` escreve, movimento/abertura.ts), o apoio e os botões; atrás, a logo
// oficial gigante de ponta a ponta (o `design` risca o contorno, o `código` preenche) e, na frente dela, o Zacarias
// recortado. Sem JS: tudo aparece pronto (logo cheia, texto comum).
import type { Textos } from '../i18n/pt';
import { LOGO } from '../lib/marca/logo';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const a = t.abertura;
---

<section class="abertura" id="inicio" data-rotulos={JSON.stringify(t.motor)}>
  <div class="abertura__palco" aria-hidden="true">
    <svg class="abertura__logo" viewBox={LOGO.viewBox} focusable="false" data-logo>
      <g data-preenche>
        <path d={LOGO.cinza} fill="currentColor" fill-rule="evenodd"></path>
        <path d={LOGO.carmim} fill="var(--color-carmim)" fill-rule="evenodd"></path>
      </g>
      <path
        class="abertura__contorno"
        d={LOGO.cinza}
        fill="none"
        fill-rule="evenodd"
        pathLength="1"
        data-contorno
      ></path>
    </svg>
    <img
      class="abertura__foto"
      src="/img/zacarias.webp"
      srcset="/img/zacarias-m.webp 420w, /img/zacarias.webp 840w"
      sizes="(max-width: 959px) 270px, 37vw"
      width="840"
      height="1050"
      alt=""
      data-foto
      fetchpriority="high"
    />
  </div>
  <div class="pagina abertura__topo">
    <div class="abertura__corpo">
      <h1 class="abertura__titulo" data-digita>
        {a.titulo.antes}
        <span data-destaque>{a.titulo.destaque}</span>
        {a.titulo.depois}
      </h1>
      <p class="abertura__apoio">{a.apoio}</p>
      <div class="abertura__botoes">
        <a class="btn btn--principal" href="/orcamento">
          {a.botaoPrincipal}
        </a>
        <a class="btn btn--contorno" href="/projetos">
          {a.botaoSecundario}
        </a>
      </div>
      <p class="abertura__nota mono">{a.nota}</p>
    </div>
  </div>
  <p class="so-leitor">{a.foto}</p>
</section>

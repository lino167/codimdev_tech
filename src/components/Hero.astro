---
// O hero (sala Início): um retrato do Zacarias num estúdio escuro. Ao rolar, a imagem faz um zoom suave em direção ao rosto;
// depois os projetos sobem pelos dois lados, sem cobrir a pessoa (lib/hero). Sem JS ou com movimento reduzido: a imagem
// parada e os projetos em lista.
import type { Textos } from '../i18n/pt';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const h = t.hero;
const esquerda = [h.casos[0], h.casos[2]];
const direita = [h.casos[1]];
---

<section class="hero" id="inicio" data-hero data-tema="escuro">
  <div class="hero__palco" data-palco>
    <div class="hero__quadro">
      <div class="hero__zoom" data-zoom>
        <img
          class="hero__imagem"
          src="/hero/retrato.webp"
          width="1920"
          height="1071"
          alt={h.foto}
          fetchpriority="high"
          data-imagem
        />
      </div>
      <span class="hero__rolar mono mono--livre" data-rolar>
        {h.rolar}
      </span>
      <p class="hero__aviso mono mono--livre">{h.aviso}</p>
    </div>

    <div class="pagina hero__texto" data-texto>
      <h1 class="hero__titulo" data-entra>
        {h.titulo.antes}
        <span data-destaque>{h.titulo.destaque}</span>
        {h.titulo.depois}
      </h1>
      <div class="hero__apoio-grupo" data-entra>
        <p class="hero__apoio">{h.apoio}</p>
        <div class="hero__botoes">
          <a class="btn btn--principal" href="/contato">
            {h.botaoPrincipal}
          </a>
          <a class="btn btn--contorno" href="/projetos">
            {h.botaoSecundario}
          </a>
        </div>
      </div>
    </div>

    <div class="hero__lado hero__lado--e" data-lado="e">
      {esquerda.map((c) => (
        <a class="caso" href={`/projetos/${c.slug}`} data-caso>
          <span class="caso__tipo mono mono--livre">
            {c.tipo} · {h.autoral}
          </span>
          <b class="caso__nome">{c.nome}</b>
          <span class="caso__texto">{c.texto}</span>
          <i class="barrinha caso__marca" aria-hidden="true"></i>
        </a>
      ))}
    </div>
    <div class="hero__lado hero__lado--d" data-lado="d">
      {direita.map((c) => (
        <a class="caso" href={`/projetos/${c.slug}`} data-caso>
          <span class="caso__tipo mono mono--livre">
            {c.tipo} · {h.autoral}
          </span>
          <b class="caso__nome">{c.nome}</b>
          <span class="caso__texto">{c.texto}</span>
          <i class="barrinha caso__marca" aria-hidden="true"></i>
        </a>
      ))}
      <a class="caso caso--convite" href="/contato" data-caso>
        <b class="caso__nome">{h.convite.titulo}</b>
        <span class="caso__texto">{h.convite.texto}</span>
        <span class="btn btn--principal">{h.convite.botao}</span>
      </a>
    </div>
  </div>
</section>

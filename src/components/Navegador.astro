---
// A janela de navegador das placas: barra de endereço e o conteúdo (slot). A barra aceita um slot "barra" para as abas
// do protótipo e a luz de status.
interface Props {
  endereco: string;
  class?: string;
}
const { endereco, class: classe } = Astro.props;
---

<div class:list={['jan', classe]}>
  <div class="jan__barra">
    <span class="jan__end mono-placa" data-endereco>
      {endereco}
    </span>
    <slot name="barra" />
  </div>
  <div class="jan__corpo">
    <slot />
  </div>
</div>

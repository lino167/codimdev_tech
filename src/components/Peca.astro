---
// Cena 03, a peça principal: cinco PLACAS empilhadas em 3D (CSS: perspective + preserve-3d). Cada placa mostra um
// pedaço real, ainda que fictício, do trabalho: a conversa e a proposta, o protótipo de um site de exemplo, o código
// sendo escrito, o site no celular com os testes e o site no ar. O palco fica preso por 5 telas e a rolagem dirige só a
// câmera (movimento/peca.ts). Na virada as placas descem e se achatam numa janela só. Sem JS ou com movimento
// reduzido: só a última placa, achatada, e a lista de etapas. Todo texto vem de pt.ts.
import type { Textos } from '../i18n/pt';
import Mare from './Mare.astro';
import Navegador from './Navegador.astro';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const p = t.peca;
const dados = { etapas: p.etapas, codigo: p.codigo, endereco: p.endereco };
---

<section class="peca" id="como-funciona" data-peca data-dados={JSON.stringify(dados)} aria-labelledby="peca-titulo">
  <div class="pagina peca__topo">
    <p class="mono">{p.rotulo}</p>
    <h2 id="peca-titulo" class="peca__titulo" data-revelar>
      {p.titulo.antes}
      <span data-destaque>{p.titulo.destaque}</span>
      {p.titulo.depois}
    </h2>
  </div>

  <div class="peca__palco" data-palco data-tema="claro">
    <div class="peca__cena" data-cena aria-hidden="true">
      <div class="peca__conjunto" data-conjunto>
        <!-- placa 1 · conversa e proposta -->
        <div class="placa" data-placa="0">
          <span class="placa__aba mono mono--livre">{p.abas[0]}</span>
          <div class="placa__tela placa__tela--conversa">
            <div class="chat">
              {p.conversa.map((m) => (
                <p class:list={['chat__msg', m.de === 'eu' && 'chat__msg--eu']} data-b>
                  {m.texto}
                </p>
              ))}
            </div>
            <div class="folha" data-b>
              <b class="folha__titulo">{p.proposta.titulo}</b>
              {p.proposta.itens.map(([rotulo, texto]) => (
                <div class="folha__item" data-b>
                  <span class="folha__rotulo">{rotulo}</span>
                  <span>{texto}</span>
                </div>
              ))}
            </div>
          </div>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>

        <!-- placa 2 · protótipo: o cursor clica nas três telas -->
        <div class="placa" data-placa="1">
          <span class="placa__aba mono mono--livre">{p.abas[1]}</span>
          <div class="placa__tela" data-fase="proto">
            <Navegador endereco={p.endereco}>
              <div slot="barra" class="jan__abas">
                {[0, 1, 2].map((i) => (
                  <span class="jan__aba" data-aba={i}>
                    {i + 1}
                  </span>
                ))}
              </div>
              <Mare t={t} tela="inicio" />
              <Mare t={t} tela="cardapio" />
              <Mare t={t} tela="contato" />
            </Navegador>
            <i class="barrinha placa__cursor" data-cursor></i>
          </div>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>

        <!-- placa 3 · código: a página ao lado do código que a constrói -->
        <div class="placa" data-placa="2">
          <span class="placa__aba mono mono--livre">{p.abas[2]}</span>
          <div class="placa__tela" data-fase="solido">
            <Navegador endereco={p.endereco} class="jan--estreita">
              <Mare t={t} tela="inicio" />
            </Navegador>
            <div class="editor">
              <div class="editor__nome mono-placa">index.html</div>
              {p.codigo.map((_, i) => (
                <div class="editor__linha">
                  <i>{i + 1}</i>
                  <span data-linha={i}></span>
                </div>
              ))}
            </div>
          </div>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>

        <!-- placa 4 · testes: o mesmo site, num celular, e a lista de testes -->
        <div class="placa" data-placa="3">
          <span class="placa__aba mono mono--livre">{p.abas[3]}</span>
          <div class="placa__tela placa__tela--testes" data-fase="solido">
            <div class="celular" data-celular>
              <div class="celular__tela">
                <Mare t={t} tela="inicio" />
              </div>
            </div>
            <ul class="testes">
              {p.checklist.map((rotulo) => (
                <li data-check>
                  <i class="barrinha"></i>
                  <span>{rotulo}</span>
                </li>
              ))}
            </ul>
          </div>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>

        <!-- placa 5 · no ar -->
        <div class="placa" data-placa="4">
          <span class="placa__aba mono mono--livre">{p.abas[4]}</span>
          <div class="placa__tela" data-fase="solido">
            <Navegador endereco={p.endereco}>
              <div slot="barra" class="jan__status" data-g="status">
                <i class="barrinha" data-pulso></i>
                <span class="mono-placa">{p.noAr}</span>
              </div>
              <Mare t={t} tela="inicio" />
            </Navegador>
          </div>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
      </div>
    </div>

    <!-- o texto de cada etapa (entra por tempo) e a barra de etapa, que anda com a rolagem -->
    <div class="peca__texto" data-texto aria-hidden="true">
      <p class="mono peca__rotulo" data-rotulo>
        {p.etapas[0].rotulo}
      </p>
      <p class="peca__frase" data-frase>
        {p.etapas[0].frase}
      </p>
      <p class="peca__fato" data-fato>
        {p.etapas[0].fato}
      </p>
    </div>
    <div class="peca__trilha" aria-hidden="true" data-trilha>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <span class="barrinha"></span>
    </div>
  </div>

  <!-- as cinco etapas em texto: leitores de tela, sem JS e com movimento reduzido -->
  <ol class="peca__lista">
    {p.etapas.map((e) => (
      <li>
        <p class="mono">{e.rotulo}</p>
        <p class="peca__lista-frase">{e.frase}</p>
        <p>{e.fato}</p>
      </li>
    ))}
  </ol>
</section>

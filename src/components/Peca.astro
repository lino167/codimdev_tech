---
// Cena 03, a peça principal: cinco PLACAS de uma janela de navegador empilhadas em 3D (CSS: perspective + preserve-3d).
// O palco fica preso por 5 telas e a rolagem dirige só a câmera (a rotação e a distância entre as placas); cada etapa
// traz uma placa nova, que desce e se encaixa por cima das anteriores (movimento/peca.ts). Na virada as placas descem
// e se achatam numa janela só. Sem JS ou com movimento reduzido: só a última placa, achatada, e a lista de etapas.
// Todo texto vem de pt.ts; o JS lê as etapas, o código e o resto pelos atributos data-*.
import type { Textos } from '../i18n/pt';
import PlacaJanela from './PlacaJanela.astro';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const p = t.peca;
const dados = {
  etapas: p.etapas,
  codigo: p.codigo,
  proposta: p.proposta,
  endereco: p.endereco,
  checklist: p.checklist,
};
---

<section class="peca" id="como-funciona" data-peca data-dados={JSON.stringify(dados)} aria-labelledby="peca-titulo">
  <div class="pagina peca__topo">
    <p class="mono">{p.rotulo}</p>
    <h2 id="peca-titulo" class="peca__titulo" data-revelar>
      {p.titulo.antes}
      <span data-destaque>{p.titulo.destaque}</span>
      {p.titulo.depois}
    </h2>
  </div>

  <div class="peca__palco" data-palco data-tema="claro">
    <div class="peca__cena" data-cena aria-hidden="true">
      <div class="peca__conjunto" data-conjunto>
        <!-- placa 1 · conversa -->
        <div class="placa" data-placa="0">
          <span class="placa__aba mono mono--livre">{p.abas[0]}</span>
          <svg class="placa__svg" viewBox="0 0 1200 720" data-fase="solido" focusable="false">
            <g data-g="e1">
              {[
                { x: 110, y: 150, w: 420, h: 124 },
                { x: 190, y: 304, w: 420, h: 100 },
                { x: 110, y: 434, w: 300, h: 84 },
              ].map((b) => (
                <g>
                  <rect class="balao" x={b.x} y={b.y} width={b.w} height={b.h} rx="4" />
                  <line
                    class="traco risco"
                    x1={b.x + 24}
                    y1={b.y + 34}
                    x2={b.x + b.w - 40}
                    y2={b.y + 34}
                    pathLength="1"
                  />
                  <line
                    class="traco risco"
                    x1={b.x + 24}
                    y1={b.y + 60}
                    x2={b.x + b.w - 90}
                    y2={b.y + 60}
                    pathLength="1"
                  />
                  {b.h > 100 && (
                    <line
                      class="traco risco"
                      x1={b.x + 24}
                      y1={b.y + 86}
                      x2={b.x + b.w - 150}
                      y2={b.y + 86}
                      pathLength="1"
                    />
                  )}
                </g>
              ))}
              <rect class="folha" x="690" y="116" width="368" height="520" rx="4"></rect>
              <text class="mono-svg" x="724" y="166" data-proposta-titulo>
                {p.proposta.titulo}
              </text>
              {p.proposta.linhas.map((_, i) => (
                <g>
                  <text class="mono-svg" x="724" y={246 + i * 100} data-proposta-linha={i} />
                  <line class="traco risco" x1="724" y1={272 + i * 100} x2="1022" y2={272 + i * 100} pathLength="1" />
                  <line class="traco risco" x1="724" y1={294 + i * 100} x2="940" y2={294 + i * 100} pathLength="1" />
                </g>
              ))}
            </g>
          </svg>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
        <!-- placa 2 · protótipo -->
        <div class="placa" data-placa="1">
          <span class="placa__aba mono mono--livre">{p.abas[1]}</span>
          <PlacaJanela t={t} variante="prototipo" />
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
        <!-- placa 3 · código -->
        <div class="placa" data-placa="2">
          <span class="placa__aba mono mono--livre">{p.abas[2]}</span>
          <PlacaJanela t={t} variante="codigo" />
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
        <!-- placa 4 · testes: o mesmo site, num celular, e a lista de testes -->
        <div class="placa" data-placa="3">
          <span class="placa__aba mono mono--livre">{p.abas[3]}</span>
          <svg class="placa__svg" viewBox="0 0 1200 720" data-fase="solido" focusable="false">
            <!-- etapa 4: o mesmo site, agora num celular, e a lista de testes -->
            <g data-g="celular">
              <rect class="moldura risco" x="260" y="60" width="300" height="620" rx="4" pathLength="1"></rect>
              <rect class="bloco cheio" x="280" y="100" width="260" height="170" rx="4"></rect>
              <rect class="barra-esb" x="296" y="124" width="150" height="16" rx="2"></rect>
              <rect class="barra-esb" x="296" y="150" width="120" height="16" rx="2"></rect>
              <rect class="bloco cheio" x="296" y="214" width="110" height="36" rx="4"></rect>
              <rect class="bloco cheio" x="280" y="290" width="260" height="120" rx="4"></rect>
              <rect class="bloco cheio" x="280" y="430" width="260" height="120" rx="4"></rect>
              <rect class="bloco cheio" x="280" y="590" width="260" height="60" rx="4"></rect>
            </g>
            <g data-g="check">
              {p.checklist.map((rotulo, i) => (
                <g transform={`translate(660 ${236 + i * 76})`} data-check={i}>
                  <rect class="traco" x="0" y="0" width="36" height="36" rx="4" />
                  <path class="traco risco" d="M 9 19 L 16 26 L 28 10" pathLength="1" />
                  <text class="svg-lista" x="60" y="26">
                    {rotulo}
                  </text>
                </g>
              ))}
            </g>
          </svg>
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
        <!-- placa 5 · no ar -->
        <div class="placa" data-placa="4">
          <span class="placa__aba mono mono--livre">{p.abas[4]}</span>
          <PlacaJanela t={t} variante="noar" />
          <span class="placa__aviso mono mono--livre">{p.ilustracao}</span>
        </div>
      </div>
    </div>

    <!-- o texto de cada etapa (entra por tempo) e a barra de etapa, que anda com a rolagem -->
    <div class="peca__texto" data-texto aria-hidden="true">
      <p class="mono peca__rotulo" data-rotulo>
        {p.etapas[0].rotulo}
      </p>
      <p class="peca__frase" data-frase>
        {p.etapas[0].frase}
      </p>
      <p class="peca__fato" data-fato>
        {p.etapas[0].fato}
      </p>
    </div>
    <div class="peca__trilha" aria-hidden="true" data-trilha>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <span class="barrinha"></span>
    </div>
  </div>

  <!-- as cinco etapas em texto: leitores de tela, sem JS e com movimento reduzido -->
  <ol class="peca__lista">
    {p.etapas.map((e) => (
      <li>
        <p class="mono">{e.rotulo}</p>
        <p class="peca__lista-frase">{e.frase}</p>
        <p>{e.fato}</p>
      </li>
    ))}
  </ol>
</section>

---
// Cena 03, a peça principal: um site fictício (um café, com texto de verdade) sendo construído em cinco etapas, em vídeo
// cinematográfico: conversa e proposta, protótipo, código, celular e testes, e o site no ar. Cada clipe parte de um quadro
// real desenhado em código (movimento/peca.ts troca de clipe a cada etapa). O palco fica preso por 5 telas; a rolagem
// escolhe a etapa e, na virada, o palco escurece. Sem JS ou com movimento reduzido: só o quadro final e a lista de etapas.
// Os clipes são ilustração (o site de exemplo é fictício) e têm a etiqueta "Ilustração". Todo texto vem de pt.ts.
import type { Textos } from '../i18n/pt';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
const p = t.peca;
const dados = { etapas: p.etapas };
---

<section class="peca" id="como-funciona" data-peca data-dados={JSON.stringify(dados)} aria-labelledby="peca-titulo">
  <div class="pagina peca__topo">
    <p class="mono">{p.rotulo}</p>
    <h2 id="peca-titulo" class="peca__titulo" data-revelar>
      {p.titulo.antes}
      <span data-destaque>{p.titulo.destaque}</span>
      {p.titulo.depois}
    </h2>
  </div>

  <div class="peca__palco" data-palco data-tema="claro">
    <div class="peca__cena" data-cena aria-hidden="true">
      <div class="peca__tela" data-tela>
        <!-- sem JS ou com movimento reduzido: o quadro final -->
        <img class="peca__fim" src="/img/peca/fim.webp" width="1280" height="720" alt="" loading="lazy" />
        {[1, 2, 3, 4, 5].map((n) => (
          <video
            class="peca__clipe"
            data-clipe
            src={`/video/etapa-${n}.mp4`}
            poster={`/img/peca/etapa-${n}.webp`}
            width="1280"
            height="720"
            muted
            playsinline
            preload="none"
            disablepictureinpicture
          />
        ))}
        <span class="peca__aviso mono mono--livre">{p.ilustracao}</span>
      </div>
    </div>

    <!-- o texto de cada etapa (entra por tempo) e a barra de etapa, que anda com a rolagem -->
    <div class="peca__texto" data-texto aria-hidden="true">
      <p class="mono peca__rotulo" data-rotulo>
        {p.etapas[0].rotulo}
      </p>
      <p class="peca__frase" data-frase>
        {p.etapas[0].frase}
      </p>
      <p class="peca__fato" data-fato>
        {p.etapas[0].fato}
      </p>
    </div>
    <div class="peca__trilha" aria-hidden="true" data-trilha>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <span class="barrinha"></span>
    </div>
  </div>

  <!-- as cinco etapas em texto: leitores de tela, sem JS e com movimento reduzido -->
  <ol class="peca__lista">
    {p.etapas.map((e) => (
      <li>
        <p class="mono">{e.rotulo}</p>
        <p class="peca__lista-frase">{e.frase}</p>
        <p>{e.fato}</p>
      </li>
    ))}
  </ol>
</section>

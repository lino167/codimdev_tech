---
// Base de todas as páginas: <head>, o canvas do mundo, o loader e o script de inicialização (src/lib/movimento).
// Sem @font-face e sem preload de fonte: quem carrega é o carga.ts. Só sem JavaScript o <noscript> traz as fontes.
import '../styles/global.css';
import '../styles/hero.css';
import '../styles/loader.css';
import '../styles/nav.css';
import Nav from '../components/Nav.astro';
import type { Textos } from '../i18n/pt';

interface Props {
  t: Textos;
}
const { t } = Astro.props;
---

<html lang={t.meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.titulo}</title>
    <meta name="description" content={t.meta.descricao} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Com JS, a página começa no loader (is-loading; sai em movimento/entrada.ts). Sem JS, a classe nunca existe
         e tudo aparece. Segurança: se o JS morrer antes de o loader começar, a página se mostra sozinha em 10 s
         (o loader cancela este timer assim que começa, porque ele mesmo pode levar até 9 s em rede lenta). -->
    <script is:inline>
      document.documentElement.classList.add('is-loading');
      window.__seguranca = setTimeout(function () {
        document.documentElement.classList.remove('is-loading');
      }, 10000);
    </script>
    <noscript>
      <link rel="stylesheet" href="/fonts/fontes.css" />
    </noscript>
  </head>
  <body>
    <canvas class="mundo" aria-hidden="true"></canvas>
    <div
      class="loader"
      data-loader
      data-rotulo-hd={t.loader.rotuloHd}
      role="progressbar"
      aria-label={t.loader.aria}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
    >
      <p class="loader__etiqueta">
        <i class="loader__elo" aria-hidden="true"></i>
        <span data-loader-rotulo>{t.loader.rotulo}</span>
        <span class="loader__n">
          <span data-loader-n>0</span>%
        </span>
      </p>
    </div>
    <Nav t={t} />
    <main id="topo" tabindex="-1">
      <slot />
    </main>
    <script>
      import { iniciar } from '../lib/movimento';
      void iniciar();
    </script>
  </body>
</html>

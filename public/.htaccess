# Hostinger (LiteSpeed/Apache): HTTPS e domínio sem www, página 404 própria e cache.
# Copiado para dist/ pelo build. A página /404.html entra na Parte 6.
RewriteEngine On

# tudo em https://codimdev.com.br (sem www)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://codimdev.com.br%{REQUEST_URI} [L,R=301]

# os arquivos de _astro/ têm hash no nome: cache de um ano
RewriteRule ^_astro/ - [E=CACHE_LONGO:1]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=31536000, immutable" env=CACHE_LONGO
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# fontes e imagens NÃO têm hash no nome: uma semana, para uma troca chegar ao visitante
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
